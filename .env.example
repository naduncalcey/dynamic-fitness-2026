# Required. Set these in Netlify under Site settings → Environment variables.
# Safe to expose — the production dataset is public and the site reads only
# published content, so no API token is involved.
NEXT_PUBLIC_SANITY_PROJECT_ID=2l5nhdjx
NEXT_PUBLIC_SANITY_DATASET=production

# Only needed if you later add draft previews / Visual Editing, or switch the
# dataset to private. Create a Viewer token at
# https://sanity.io/manage/project/2l5nhdjx/api#tokens
# Keep it unprefixed so it stays server-only — never NEXT_PUBLIC_.
# SANITY_API_READ_TOKEN=
